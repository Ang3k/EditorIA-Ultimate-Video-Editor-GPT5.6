# O editor usa a sessão autenticada do Codex CLI; não é necessário OPENAI_API_KEY.
CODEX_CLI_BIN=codex.cmd
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=max
CODEX_TIMEOUT_MS=900000
CODEX_MAX_RETRIES=1

# Whisper local faz somente a transcrição do áudio.
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_WHISPER_DEVICE=cuda
LOCAL_WHISPER_COMPUTE_TYPE=float16

# A descoberta usa yt-dlp, sem YouTube Data API.
YOUTUBE_MAX_SEARCHES=36
YTDLP_PLAYER_CLIENT=android
YOUTUBE_SEARCH_PROVIDER=yt-dlp
